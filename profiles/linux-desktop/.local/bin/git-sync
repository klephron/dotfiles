#!/usr/bin/env python3

import argparse
import csv
import sys
import subprocess
from pathlib import Path


def git(*args, cwd=None):
    subprocess.run(["git", *args], cwd=cwd, check=True)


def sync(url: str, destination: Path, recursive: bool):
    if (destination / ".git").exists():
        git("fetch", url, cwd=destination)
        git("merge", "--ff-only", "FETCH_HEAD", cwd=destination)

        if recursive:
            git("submodule", "update", "--init", "--recursive", cwd=destination)


    elif destination.exists():
        raise RuntimeError(f"{destination} exists but is not a Git repository.")

    else:
        destination.parent.mkdir(parents=True, exist_ok=True)

        args = ["clone"]
        if recursive:
            args.append("--recurse-submodules")

        git(*args, url, str(destination))

    print(f"[git-sync]: {url} -> {destination}: done", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--csv-file", type=Path, required=True, help="Path to CSV file with header fields: destination(path),origin(str),recursive(bool)")
    args = parser.parse_args()

    failed = 0

    with args.csv_file.open(newline="", encoding="utf-8-sig") as file:
        reader = csv.DictReader(file)

        if reader.fieldnames is None:
            parser.error("CSV file must contain a header")

        reader.fieldnames = [name.strip() for name in reader.fieldnames]

        for row in reader:
            line_number = reader.line_num

            try:
                url = row["origin"].strip()
                destination = Path(row["destination"].strip()).expanduser()
                recursive = row["recursive"].strip().lower()

                sync(url, destination, recursive == "true")

            except (subprocess.CalledProcessError, OSError, ValueError, RuntimeError) as exc:
                print(f"[git-sync]: error line {line_number}: {exc}", file=sys.stderr)
                failed += 1

    if failed:
        raise SystemExit(f"{failed} repository(s) failed")


if __name__ == "__main__":
    main()

