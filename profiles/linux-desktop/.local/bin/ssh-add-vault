#!/usr/bin/env python3

import argparse
import json
import os
import shlex
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path
from urllib.error import HTTPError
from urllib.parse import quote
from urllib.request import Request, urlopen


@dataclass(frozen=True)
class Config:
    address: str
    token: str
    mount: str
    prefix: str
    field: str
    debug: bool


def log(message: str) -> None:
    print(f"[{Path(sys.argv[0]).stem}]: {message}", file=sys.stderr)


def bao_request(config: Config, endpoint: str, list_keys: bool) -> dict:
    url = f"{config.address}/v1/{quote(endpoint, safe='/')}"

    if list_keys:
        url += "?list=true"

    if config.debug:
        log(f"+ GET {url}")

    request = Request(
        url,
        headers={"X-Vault-Token": config.token},
    )

    with urlopen(request) as response:
        return json.load(response)


def bao_get_secret(config: Config, path: str) -> dict:
    response = bao_request(config, f"{config.mount}/data/{path}", list_keys=False)
    return response["data"]["data"]


# first try to get secret, then recurse (preorder-style traversal)
def bao_list_secrets(config: Config, prefix: str) -> Iterator[str]:
    prefix = prefix.strip("/")

    if prefix:
        try:
            bao_get_secret(config, prefix)
        except HTTPError as exc:
            if exc.code != 404:
                raise
        else:
            yield prefix
            return

    response = bao_request(
        config,
        f"{config.mount}/metadata/{prefix}",
        list_keys=True,
    )

    for entry in response["data"]["keys"]:
        path = f"{prefix}/{entry}".lstrip("/")

        if entry.endswith("/"):
            yield from bao_list_secrets(config, path)
        else:
            yield path


def agent_add_key(config: Config, key: str) -> None:
    key = key.rstrip("\n") + "\n"
    command = f"printf '%s' {shlex.quote(key)} | ssh-add -"

    if config.debug:
        log(f"+ {command}")

    subprocess.run(
        command,
        shell=True,
        executable="/bin/sh",
        capture_output=True,
        text=True,
        check=True,
    )


def config_load() -> Config:
    parser = argparse.ArgumentParser(
        description="Recursively load SSH private keys from Vault/OpenBao KV v2 into ssh-agent."
    )
    parser.add_argument(
        "-m", "--mount",
        required=True,
        help="KV v2 mount point",
    )
    parser.add_argument(
        "-p", "--prefix",
        required=True,
        help="Secret path prefix",
    )
    parser.add_argument(
        "-f", "--field",
        default="ssh-private-key",
        help="Secret field containing the SSH private key",
    )
    parser.add_argument(
        "-d", "--debug",
        action="store_true",
        help="Enable debug logging",
    )

    args = parser.parse_args()

    address = os.environ.get("VAULT_ADDR") or os.environ.get("BAO_ADDR")
    token = os.environ.get("VAULT_TOKEN") or os.environ.get("BAO_TOKEN")

    if not os.environ.get("SSH_AUTH_SOCK"):
        parser.error("SSH_AUTH_SOCK is not set")

    if not address:
        parser.error("VAULT_ADDR or BAO_ADDR must be set")

    if not token:
        parser.error("VAULT_TOKEN or BAO_TOKEN must be set")

    return Config(
        address=address.rstrip("/"),
        token=token,
        mount=args.mount.strip("/"),
        prefix=args.prefix.strip("/"),
        field=args.field,
        debug=args.debug,
    )


def main() -> int:
    config = config_load()
    failed = False

    try:
        for path in bao_list_secrets(config, config.prefix):
            try:
                secret = bao_get_secret(config, path)
                key = secret.get(config.field)

                if not key:
                    log(f"skipped {path}: missing {config.field}")
                    continue

                agent_add_key(config, key)
                log(f"added {path}")

            except (HTTPError, OSError, ValueError, KeyError,
                    subprocess.CalledProcessError) as exc:
                error = (
                    exc.stderr.strip()
                    if isinstance(exc, subprocess.CalledProcessError)
                    else str(exc)
                )
                log(f"failed {path}: {error}")
                failed = True

    except (HTTPError, OSError, ValueError, KeyError) as exc:
        log(f"failed to list secrets: {exc}")
        failed = True

    return int(failed)


if __name__ == "__main__":
    sys.exit(main())

