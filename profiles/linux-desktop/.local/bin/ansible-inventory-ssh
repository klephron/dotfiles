#!/usr/bin/env python3

import argparse
import os
import sys
from pathlib import Path
from typing import Any

import yaml
from sshconf import empty_ssh_config_file, read_ssh_config


def debug(message: str, enabled: bool) -> None:
    if enabled:
        print(message, file=sys.stderr)


def unwrap(value: Any) -> Any:
    if isinstance(value, dict):
        if "__ansible_unsafe" in value:
            return unwrap(value["__ansible_unsafe"])

        return {
            key: unwrap(item)
            for key, item in value.items()
        }

    if isinstance(value, list):
        return [unwrap(item) for item in value]

    return value


def write_key(path: Path, content: str, mode: int) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC

    fd = os.open(path, flags, mode)

    with os.fdopen(fd, "w", encoding="utf-8") as file:
        os.fchmod(file.fileno(), mode)
        file.write(content)

        if not content.endswith("\n"):
            file.write("\n")


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        required=True,
        help="Output directory for SSH configuration and keys",
    )

    parser.add_argument(
        "-d",
        "--debug",
        action="store_true",
        help="Print generated changes",
    )

    args = parser.parse_args()

    output = (Path.cwd() / args.output).resolve()
    keys_dir = output / "keys"
    config_path = output / "config"

    try:
        inventory = unwrap(yaml.safe_load(sys.stdin))

        if not isinstance(inventory, dict):
            raise ValueError("inventory must be a yaml mapping")

        meta = inventory.get("_meta")

        if not isinstance(meta, dict):
            raise ValueError("inventory is missing _meta")

        hostvars = meta.get("hostvars")

        if not isinstance(hostvars, dict):
            raise ValueError("inventory is missing _meta.hostvars")

        for hostname, variables in hostvars.items():
            if not isinstance(variables, dict):
                raise ValueError(f"invalid host variables for {hostname}")

    except (yaml.YAMLError, ValueError, TypeError) as exc:
        parser.error(f"invalid ansible inventory yaml: {exc}")

    if not output.exists():
        output.mkdir(parents=True)
        debug(f"created: {output}", args.debug)

    if not keys_dir.exists():
        keys_dir.mkdir(mode=0o700)
        debug(f"created: {keys_dir}", args.debug)

    keys_dir.chmod(0o700)

    if config_path.exists():
        ssh_config = read_ssh_config(str(config_path))
    else:
        ssh_config = empty_ssh_config_file()

    existing_hosts = set(ssh_config.hosts())

    for hostname, variables in sorted(hostvars.items()):
        username = variables.get("ansible_user")
        private_key = variables.get("ansible_private_key")
        public_key = variables.get("ansible_public_key")

        settings = {}

        if variables.get("ansible_host") is not None:
            settings["Hostname"] = variables["ansible_host"]

        if variables.get("ansible_port") is not None:
            settings["Port"] = variables["ansible_port"]

        if username:
            settings["User"] = username

        if private_key or public_key:
            if not username:
                raise ValueError(
                    f"{hostname}: ansible_user is required when "
                    "ssh keys are provided"
                )

            if any(
                char in hostname + username
                for char in ("/", "\\", "\0", "\n", "\r")
            ):
                raise ValueError(
                    f"{hostname}: invalid hostname or username "
                    "for key filename"
                )

            key_name = f"{hostname}:{username}"
            private_key_path = keys_dir / key_name
            public_key_path = keys_dir / f"{key_name}.pub"

            if private_key:
                settings["IdentityFile"] = str(
                    private_key_path.resolve()
                )
                settings["IdentitiesOnly"] = "yes"
                write_key(private_key_path, private_key, 0o600)
                debug(f"written: {private_key_path}", args.debug)

            if public_key:
                write_key(public_key_path, public_key, 0o644)
                debug(f"written: {public_key_path}", args.debug)

        if hostname in existing_hosts:
            ssh_config.remove(hostname)
            debug(f"removed: {hostname}", args.debug)

        ssh_config.add(hostname, **settings)
        debug( f"added: {hostname}", args.debug)

    ssh_config.write(str(config_path))
    debug( f"written: {config_path}", args.debug)


if __name__ == "__main__":
    main()
