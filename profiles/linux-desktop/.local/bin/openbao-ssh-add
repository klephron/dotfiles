#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import sys


def bao(*args: str) -> str:
    result = subprocess.run(
        ["bao", *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout


def list_secrets(mount: str, prefix: str):
    try:
        output = bao(
            "kv", "list",
              "-format=json",
            f"-mount={mount}",
            prefix,
        )
    except subprocess.CalledProcessError as exc:
        print(
            f"Failed to list {prefix}: {exc.stderr.strip()}",
            file=sys.stderr,
        )
        raise

    for entry in json.loads(output):
        path = f"{prefix.rstrip('/')}/{entry}".lstrip("/")

        if entry.endswith("/"):
            yield from list_secrets(mount, path)
        else:
            yield path


def get_private_key(mount: str, path: str, field: str) -> str | None:
    try:
        output = bao(
            "kv", "get",
            "-format=json",
            f"-mount={mount}",
            path,
        )
        secret = json.loads(output)["data"]["data"]
        return secret.get(field)
    except subprocess.CalledProcessError as exc:
        print(
            f"Failed to read {path}: {exc.stderr.strip()}",
            file=sys.stderr,
        )
        raise


def add_key(key: str) -> None:
    result = subprocess.run(
        ["ssh-add", "-"],
        input=key.rstrip("\n") + "\n",
        text=True,
        capture_output=True,
    )

    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Recursively load SSH private keys from OpenBao KV v2 into ssh-agent."
    )
    parser.add_argument(
        "-m", "--mount", help="KV v2 mount point"
    )
    parser.add_argument("-p", "--prefix", help="Secret path prefix")
    parser.add_argument(
        "--field",
        default="ssh_private_key",
        help="Secret field containing the SSH private key",
    )
    args = parser.parse_args()

    if not os.environ.get("SSH_AUTH_SOCK"):
        print("SSH_AUTH_SOCK is not set. Start ssh-agent first.", file=sys.stderr)
        return 1

    added = 0
    skipped = 0
    failed = 0

    try:
        for path in list_secrets(args.mount, args.prefix):
            try:
                key = get_private_key(args.mount, path, args.field)

                if not key:
                    print(f"SKIPPED {path}: no {args.field}")
                    skipped += 1
                    continue

                add_key(key)
                print(f"ADDED {path}")
                added += 1

            except (subprocess.CalledProcessError, RuntimeError, ValueError, KeyError) as exc:
                print(f"FAILED {path}: {exc}", file=sys.stderr)
                failed += 1

    except (subprocess.CalledProcessError, ValueError) as exc:
        print(f"Failed to enumerate secrets: {exc}", file=sys.stderr)
        return 1

    print(f"Finished: {added} added, {skipped} skipped, {failed} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())

