#!/usr/bin/env python3

import argparse
from pathlib import Path
import json
import os
import subprocess
import sys
import shlex
from collections.abc import Iterator

def log(message: str) -> None:
    print(f"[{Path(sys.argv[0]).stem}]: {message}", file=sys.stderr)


def bao_run(*args: str) -> str:
    command = ["bao", *args]
    log(f"+ {shlex.join(command)}")

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout


def bao_list_secrets(mount: str, prefix: str) -> Iterator[str]:
    output = bao_run("kv", "list", "-format=json", f"-mount={mount}", prefix)

    for entry in json.loads(output):
        path = f"{prefix.rstrip('/')}/{entry}".lstrip("/")

        if entry.endswith("/"):
            yield from bao_list_secrets(mount, path)
        else:
            yield path


def bao_get_field(mount: str, path: str, field: str) -> str | None:
    output = bao_run("kv", "get", "-format=json", f"-mount={mount}", path)
    secret = json.loads(output)["data"]["data"]
    return secret.get(field)


def agent_add_key(key: str) -> None:
    subprocess.run(
        ["ssh-add", "-"],
        input=key.rstrip("\n") + "\n",
        text=True,
        capture_output=True,
        check=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Recursively load SSH private keys from OpenBao KV v2 into ssh-agent."
    )
    parser.add_argument(
        "-m", "--mount",
        required=True,
        help="KV v2 mount point",
    )
    parser.add_argument(
        "-p", "--prefix",
        required=True,
        help="Secret path prefix",
    )
    parser.add_argument(
        "--field",
        default="ssh_private_key",
        help="Secret field containing the SSH private key",
    )
    args = parser.parse_args()

    if not os.environ.get("SSH_AUTH_SOCK"):
        log("SSH_AUTH_SOCK is not set.")
        return 1

    try:
        for path in bao_list_secrets(args.mount, args.prefix):
            try:
                key = bao_get_field(args.mount, path, args.field)

                if not key:
                    log(f"skipped {path}: missing {args.field}")
                    continue

                agent_add_key(key)
                log(f"added {path}")

            except (subprocess.CalledProcessError, ValueError, KeyError) as exc:
                error = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
                log(f"failed {path}: {error}")

    except (subprocess.CalledProcessError, ValueError) as exc:
        error = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
        log(f"failed to list secrets: {error}")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())

