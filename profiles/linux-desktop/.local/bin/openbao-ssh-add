#!/usr/bin/env python3

import argparse
import json
import os
import shlex
import subprocess
import sys
from collections.abc import Iterator
from pathlib import Path


def log(message: str) -> None:
    print(f"[{Path(sys.argv[0]).stem}]: {message}", file=sys.stderr)


def bao_run(*args: str, debug: bool) -> str:
    command = ["bao", *args]

    if debug:
        log(f"+ {shlex.join(command)}")

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout


def bao_list_secrets(mount: str, prefix: str, debug: bool) -> Iterator[str]:
    try:
        bao_run(
            "kv", "get", "-format=json", f"-mount={mount}", prefix,
            debug=debug,
        )
        yield prefix.rstrip("/")
        return
    except subprocess.CalledProcessError:
        pass

    output = bao_run(
        "kv", "list", "-format=json", f"-mount={mount}", prefix,
        debug=debug,
    )

    for entry in json.loads(output):
        path = f"{prefix.rstrip('/')}/{entry}".lstrip("/")

        if entry.endswith("/"):
            yield from bao_list_secrets(mount, path, debug=debug)
        else:
            yield path


def bao_get_field(mount: str, path: str, field: str, debug: bool) -> str | None:
    output = bao_run(
        "kv", "get", "-format=json", f"-mount={mount}", path,
        debug=debug,
    )
    secret = json.loads(output)["data"]["data"]
    return secret.get(field)


def agent_add_key(key: str, debug: bool) -> None:
    key = key.rstrip("\n") + "\n"
    command = f"printf '%s' {shlex.quote(key)} | ssh-add -"

    if debug:
        log(f"+ {command}")

    subprocess.run(
        command,
        shell=True,
        executable="/bin/sh",
        capture_output=True,
        text=True,
        check=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Recursively load SSH private keys from OpenBao KV v2 into ssh-agent."
    )
    parser.add_argument(
        "-m", "--mount",
        required=True,
        help="KV v2 mount point",
    )
    parser.add_argument(
        "-p", "--prefix",
        required=True,
        help="Secret path prefix",
    )
    parser.add_argument(
        "-f", "--field",
        default="ssh-private-key",
        help="Secret field containing the SSH private key",
    )
    parser.add_argument(
        "-d", "--debug",
        action="store_true",
        help="Enable debug logging",
    )
    args = parser.parse_args()

    failed = False

    if not os.environ.get("SSH_AUTH_SOCK"):
        log("SSH_AUTH_SOCK is not set.")
        failed = True

    if not failed:
      try:
          for path in bao_list_secrets(args.mount, args.prefix, debug=args.debug):
              try:
                  key = bao_get_field(args.mount, path, args.field, debug=args.debug)

                  if not key:
                      log(f"skipped {path}: missing {args.field}")
                      continue

                  agent_add_key(key, debug=args.debug)
                  log(f"added {path}")

              except (subprocess.CalledProcessError, ValueError, KeyError) as exc:
                  error = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
                  log(f"failed {path}: {error}")
                  failed = True

      except (subprocess.CalledProcessError, ValueError) as exc:
          error = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
          log(f"failed to list secrets: {error}")
          failed = True

    return int(failed)


if __name__ == "__main__":
    sys.exit(main())

